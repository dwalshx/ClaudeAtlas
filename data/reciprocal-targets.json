  "_comment": "Every full run is also archived to data/reciprocal-history/<run date>.json for trend comparison. Hand-editable. `tiers` maps each tier to the one question it answers plus its report `order`. Each target: {domain, operator, tier, source, note?, cited?}. `cited: true` marks the AEO top-cited slice (top of the 2,000+ unique domains AI assistants cited across our AEO probe runs) — a domain that is both thematic and cited stays in its thematic tier with cited: true. One entry per domain. Domains are bare hosts; scripts/reciprocal-pass.js builds https://<domain> URLs. To remove a domain from the pass, delete its entry.",
  "tiers": {
    "named-operator": {"question":"Do the operators whose bots crawl us let a declared bot crawl them?","order":1},
    "infrastructure": {"question":"Do the cloud vendors hosting most anonymous scraper traffic admit a declared bot to their own sites?","order":2},
    "control": {"question":"Do we pass our own probe?","order":3},
    "seed": {"question":"Scope-doc seeds not yet seen in the request log.","order":4},
    "agent-native": {"question":"Are the companies building the agent economy agent-ready themselves?","order":5},
    "positive-control": {"question":"Known llms.txt publishers — if these show a cross, the standards probe is broken, not the site.","order":6},
    "ecommerce": {"question":"How does the agentic-commerce battleground treat a declared bot?","order":7},
    "publisher": {"question":"How do licensing-deal-era publishers treat a declared bot, and do they name AI bots in robots.txt?","order":8},
    "travel-local": {"question":"Can a declared bot reach the booking and local-discovery sites agents are demoed on?","order":9},
    "dev-reference": {"question":"Do the sources coding agents actually fetch admit a declared bot?","order":10},
    "bot-defense": {"question":"Do bot-defense vendors let a polite declared bot through their own front door?","order":11},
    "public-info": {"question":"Is public-interest information reachable by a declared bot?","order":12},
    "citation": {"question":"How do the domains AI assistants most often cite (top slice of 2,000+ unique domains from our AEO probe runs) treat a declared bot?","order":13}
