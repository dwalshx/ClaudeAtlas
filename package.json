{
  "name": "claudeatlas",
  "version": "1.0.0",
  "type": "module",
  "description": "Curated discovery index of top Claude ecosystem skills",
  "scripts": {
    "scrape": "node scripts/scrape.js",
    "scrape:discover": "node scripts/scrape-discover-repos.js",
    "scrape:smoke": "node scripts/scrape-smoke.js",
    "scrape:discover:full": "node scripts/scrape.js --mode=full",
    "scrape:pulse": "node scripts/scrape-pulse.js",
    "filter": "node scripts/filter.js",
    "pipeline": "node scripts/scrape.js && node scripts/filter.js",
    "badges": "node scripts/generate-badges.js",
    "registry": "node scripts/generate-registry.js",
    "embed": "node scripts/embed-skills.js",
    "upload-vectors": "node scripts/upload-vectors.js",
    "compute-similar": "node scripts/compute-similar.js",
    "enrich": "node scripts/enrich.js",
    "marketplace": "node scripts/generate-marketplace.js",
    "mine-apis": "node scripts/mine-apis.js",
    "prebuild": "node scripts/generate-badges.js && node scripts/generate-registry.js && node scripts/compute-similar.js && node scripts/generate-marketplace.js && node scripts/mine-apis.js && node scripts/check-tier-budget.js",
    "check:patterns": "node scripts/check-banned-patterns.js",
    "check:size": "node scripts/check-skills-size.js",
    "test:lib": "node --test scripts/lib/__tests__/ndjson.test.js",
    "fixture:gen": "node scripts/lib/__tests__/fixture-skills-50k.js",
    "smoke:astro": "node scripts/smoke-astro-loader.mjs",
    "publish:kv": "node scripts/lib/publish-kv.js",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/check-sitemap-completeness.js && node scripts/check-asset-sizes.js",
    "preview": "astro preview",
    "astro": "astro",
    "check:sitemap": "node scripts/check-sitemap-completeness.js",
    "check:sitemap-stability": "node scripts/check-sitemap-stability.js",
    "check:tier-budget": "node scripts/check-tier-budget.js",
    "check:asset-sizes": "node scripts/check-asset-sizes.js"
  },
  "keywords": [
    "claude",
    "skills",
    "directory",
    "index"
  ],
  "author": "Dan Walsh",
  "license": "MIT",
  "dependencies": {
    "@astrojs/sitemap": "^3.3.1",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.7.10",
    "gray-matter": "^4.0.3",
    "p-queue": "^9.1.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
