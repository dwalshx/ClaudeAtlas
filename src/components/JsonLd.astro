---
/**
 * src/components/JsonLd.astro — Phase 3.1.3 (Agent Hub)
 *
 * Reusable emitter for schema.org JSON-LD blocks. Renders a
 * <script type="application/ld+json"> tag with the supplied data
 * serialized as JSON.
 *
 * Used by:
 *   - src/pages/skills/[...slug].astro — Article + creator + citation per skill
 *   - src/pages/index.astro            — DataCatalog + creator for the homepage
 *
 * Validation: paste a built page URL into
 * https://search.google.com/test/rich-results after deploy.
 */
const { data } = Astro.props;
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />
