---
const { label, value, weight } = Astro.props;
const clampedValue = Math.min(100, Math.max(0, Math.round(value)));
const barColor = clampedValue >= 70 ? 'bg-emerald-500' : clampedValue >= 40 ? 'bg-amber-500' : 'bg-red-400';
---

<div class="flex items-center gap-3">
  <div class="w-28 text-xs text-gray-400 flex justify-between">
    <span>{label}</span>
    <span class="text-gray-600">{weight}</span>
  </div>
  <div class="flex-1 bg-gray-800 rounded-full h-2">
    <div class={`h-2 rounded-full ${barColor}`} style={`width: ${clampedValue}%`}></div>
  </div>
  <span class="text-xs text-gray-500 w-8 text-right">{clampedValue}</span>
</div>
