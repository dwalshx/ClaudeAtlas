---
import { categoryColor, getCategorySlug } from '../lib/skills.js';

const { category, count, active = false } = Astro.props;
const cc = categoryColor(category);
const slug = getCategorySlug(category);
---

<a
  href={`/category/${slug}/`}
  class:list={[
    'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium transition-all whitespace-nowrap',
    active
      ? 'bg-atlas-600 text-white ring-2 ring-atlas-400/50'
      : 'bg-gray-800 text-gray-300 hover:bg-gray-700 hover:text-white border border-gray-700',
  ]}
>
  {category}
  {count !== undefined && (
    <span class="text-xs opacity-70">({count})</span>
  )}
</a>
