---
import { timeAgo, tierColor, categoryColor } from '../lib/skills.js';

const { skill } = Astro.props;
const tc = tierColor(skill.quality_tier);
const cc = categoryColor(skill.category);
const updated = timeAgo(skill.repo_pushed_at);
const installCmd = `claude install-skill ${skill.repo_full_name}`;
---

<a href={`/skills/${skill.slug}/`} class="group block bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-atlas-600 hover:bg-gray-900/80 transition-all duration-200">
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${cc}`}>
      {skill.category}
    </span>
    <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium ${tc.bg} ${tc.text}`}>
      <span class={`w-1.5 h-1.5 rounded-full ${tc.dot}`}></span>
      {skill.quality_tier === 'featured' ? 'Featured' : skill.quality_tier === 'solid' ? 'Solid' : 'Listed'}
    </span>
  </div>

  <h3 class="text-white font-semibold text-lg mb-1 group-hover:text-atlas-400 transition-colors font-mono">
    {skill.name}
  </h3>

  <p class="text-gray-400 text-sm mb-4 line-clamp-2 leading-relaxed">
    {skill.description || 'No description available.'}
  </p>

  <div class="flex items-center justify-between text-xs text-gray-500">
    <div class="flex items-center gap-3">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
        {skill.repo_stars.toLocaleString()}
      </span>
      <span class="text-gray-600">Updated {updated}</span>
    </div>
    <span class="text-gray-600 font-mono text-[11px]">
      {skill.repo_full_name.split('/')[0]}
    </span>
  </div>
</a>
