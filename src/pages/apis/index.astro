---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const apiGraphPath = join(__dirname, '../../../data/api-graph.json');

let apiGraph = { services: {}, service_count: 0, skills_with_integrations: 0, integration_rate: 0, top_services: [], skill_count: 0 };
if (existsSync(apiGraphPath)) {
  try {
    apiGraph = JSON.parse(readFileSync(apiGraphPath, 'utf-8'));
  } catch {}
}

// Group services by category for the page
const servicesByCategory = new Map();
for (const svc of Object.values(apiGraph.services) as any[]) {
  const cat = svc.category || 'Other';
  if (!servicesByCategory.has(cat)) servicesByCategory.set(cat, []);
  servicesByCategory.get(cat).push(svc);
}

// Sort categories by total skill count across all services in that category
const sortedCategories = [...servicesByCategory.entries()].sort((a, b) => {
  const aTotal = a[1].reduce((s: number, svc: any) => s + svc.skill_count, 0);
  const bTotal = b[1].reduce((s: number, svc: any) => s + svc.skill_count, 0);
  return bTotal - aTotal;
});

// Sort services within each category by skill_count descending
for (const [, services] of sortedCategories) {
  services.sort((a: any, b: any) => b.skill_count - a.skill_count);
}

const totalServices = Object.keys(apiGraph.services).length;
const description = `${totalServices} APIs, services, and platforms referenced across ${apiGraph.skills_with_integrations} Claude skills. See which tools the ecosystem integrates with.`;
---

<BaseLayout title="API & Service Integrations" description={description}>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-white mb-3">API & Service Integrations</h1>
      <p class="text-gray-400 max-w-3xl mb-4">
        {apiGraph.skills_with_integrations} of {apiGraph.skill_count.toLocaleString()} indexed skills ({apiGraph.integration_rate}%) reference at least one known API, service, or platform. This graph is automatically extracted from skill content — no manual tagging.
      </p>
      <div class="flex flex-wrap gap-4 text-sm text-gray-500 font-mono">
        <span>{totalServices} services detected</span>
        <span>·</span>
        <span>{apiGraph.skills_with_integrations} skills with integrations</span>
        <span>·</span>
        <span>{apiGraph.integration_rate}% integration rate</span>
      </div>
    </header>

    <!-- Top services banner -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-10">
      <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-4">Most Referenced Services</h2>
      <div class="flex flex-wrap gap-2">
        {(apiGraph.top_services || []).slice(0, 15).map((svc: any) => (
          <a
            href={`/apis/${svc.id}/`}
            class="inline-flex items-center gap-2 px-3 py-2 bg-gray-800 hover:bg-gray-700 border border-gray-700 rounded-lg text-sm text-gray-200 hover:text-white transition-colors"
          >
            <span class="font-medium">{svc.name}</span>
            <span class="text-xs text-gray-500">{svc.skill_count}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Services by category -->
    {sortedCategories.map(([category, services]: [string, any[]]) => (
      <section class="mb-10">
        <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-atlas-500"></span>
          {category}
          <span class="text-xs text-gray-500 font-normal ml-2">{services.length} service{services.length === 1 ? '' : 's'}</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {services.map((svc: any) => (
            <a
              href={`/apis/${svc.id}/`}
              class="flex items-center justify-between p-4 bg-gray-900 border border-gray-800 rounded-lg hover:border-atlas-500/40 hover:bg-gray-800/50 transition-colors"
            >
              <div class="min-w-0">
                <div class="font-medium text-white truncate">{svc.name}</div>
                {svc.url && (
                  <div class="text-xs text-gray-500 truncate">{svc.url.replace('https://', '')}</div>
                )}
              </div>
              <div class="flex items-center gap-2 ml-4">
                <span class="text-sm font-mono text-atlas-400">{svc.skill_count}</span>
                <span class="text-xs text-gray-600">skills</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="text-xs text-gray-600 mt-10 text-center">
      Integrations are detected automatically from skill content using keyword matching — not manually tagged. Some false positives are possible.
    </p>
  </section>
</BaseLayout>
