---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/SkillCard.astro';
import { allSkills } from '../../lib/skills.js';
import { readFileSync, existsSync } from 'fs';
import { join, dirname } from 'path';
import { fileURLToPath } from 'url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const apiGraphPath = join(__dirname, '../../../data/api-graph.json');

let apiGraph = { services: {}, skill_integrations: {} };
if (existsSync(apiGraphPath)) {
  try {
    apiGraph = JSON.parse(readFileSync(apiGraphPath, 'utf-8'));
  } catch {}
}

export function getStaticPaths() {
  const graphPath = join(dirname(fileURLToPath(import.meta.url)), '../../../data/api-graph.json');
  if (!existsSync(graphPath)) return [];
  const graph = JSON.parse(readFileSync(graphPath, 'utf-8'));
  return Object.values(graph.services).map((svc: any) => ({
    params: { service: svc.id },
    props: { service: svc },
  }));
}

const { service } = Astro.props;

// Get full skill records for the skills that reference this service
const serviceSkills = (service.skills || [])
  .map((slug: string) => allSkills.find(s => s.slug === slug))
  .filter(Boolean)
  .sort((a: any, b: any) => (b.quality_score || 0) - (a.quality_score || 0));

const featuredCount = serviceSkills.filter((s: any) => s.quality_tier === 'featured').length;
const totalStars = serviceSkills.reduce((sum: number, s: any) => sum + (s.repo_stars || 0), 0);

// Find other services that commonly co-occur with this one
const coServices = new Map<string, number>();
for (const slug of service.skills || []) {
  const integrations = (apiGraph.skill_integrations as any)?.[slug] || [];
  for (const svcId of integrations) {
    if (svcId === service.id) continue;
    coServices.set(svcId, (coServices.get(svcId) || 0) + 1);
  }
}
const topCoServices = [...coServices.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([id, count]) => ({
    id,
    name: (apiGraph.services as any)?.[id]?.name || id,
    count,
  }));

const description = `${service.skill_count} Claude skills integrate with ${service.name}. Browse skills that use the ${service.name} API, SDK, or platform.`;
---

<BaseLayout title={`${service.name} · API Integrations`} description={description}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <a href="/apis/" class="text-sm text-gray-500 hover:text-atlas-400 transition-colors mb-6 inline-flex items-center gap-1">
      ← All integrations
    </a>

    <header class="mb-10 mt-4">
      <div class="flex items-baseline gap-3 flex-wrap">
        <h1 class="text-3xl font-bold text-white">{service.name}</h1>
        <span class="text-xs text-gray-600 uppercase tracking-wide">{service.category}</span>
      </div>
      {service.url && (
        <a href={service.url} target="_blank" rel="noopener" class="text-sm text-atlas-400 hover:underline mt-1 inline-block">
          {service.url.replace('https://', '')} →
        </a>
      )}
      <div class="flex gap-4 mt-4 text-sm text-gray-500 font-mono flex-wrap">
        <span>{service.skill_count} skills</span>
        <span>·</span>
        <span>{featuredCount} Featured</span>
        <span>·</span>
        <span>{totalStars.toLocaleString()} total stars</span>
      </div>
    </header>

    {topCoServices.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-3">Commonly used with</h2>
        <div class="flex flex-wrap gap-2">
          {topCoServices.map(co => (
            <a href={`/apis/${co.id}/`} class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-800 hover:bg-gray-700 border border-gray-700 rounded-full text-xs text-gray-300 hover:text-white transition-colors">
              {co.name}
              <span class="text-gray-500">({co.count})</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section>
      <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-atlas-500"></span>
        Skills using {service.name} ({service.skill_count})
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {serviceSkills.map((skill: any) => (
          <SkillCard skill={skill} />
        ))}
      </div>
    </section>

    <p class="text-xs text-gray-600 mt-10 text-center">
      Integration detected automatically from skill content. Some results may be false positives.
    </p>
  </section>
</BaseLayout>
