---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/SkillCard.astro';
import CategoryChip from '../../components/CategoryChip.astro';
import { allSkills, getAllCategories, getCategorySlug, getCategoryFromSlug } from '../../lib/skills.js';

export function getStaticPaths() {
  const categories = getAllCategories();
  return categories.map(cat => ({
    params: { category: cat.slug },
    props: { categoryName: cat.name, count: cat.count },
  }));
}

const { categoryName, count } = Astro.props;
// Phase 3.1.x: cap visible cards to top 100 by quality_score. At 35k
// catalog, "AI and Automation" had ~18k skills → 35MB HTML which
// exceeds Cloudflare's 25 MB per-asset cap. Full per-category catalog
// is discoverable via /browse + (future) category filter, or via
// /api/v1/search?category=X.
const VISIBLE_LIMIT = 100;
const allInCategory = allSkills
  .filter(s => s.category === categoryName && !s.is_duplicate)
  .sort((a, b) => b.quality_score - a.quality_score);
const skills = allInCategory.slice(0, VISIBLE_LIMIT);
const hasMore = allInCategory.length > VISIBLE_LIMIT;
const categories = getAllCategories();
---

<BaseLayout
  title={`${categoryName} Skills`}
  description={`Browse ${count} curated ${categoryName.toLowerCase()} skills for Claude and other AI coding assistants.`}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-gray-400">{categoryName}</span>
    </nav>

    <h1 class="text-3xl font-bold text-white mb-2">{categoryName}</h1>
    <p class="text-gray-400 mb-8">{count} curated skills in this category</p>

    <!-- Other categories -->
    <div class="flex flex-wrap gap-2 mb-10">
      {categories.map(cat => (
        <CategoryChip
          category={cat.name}
          count={cat.count}
          active={cat.name === categoryName}
        />
      ))}
    </div>

    <!-- Skills grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {skills.map(skill => (
        <SkillCard skill={skill} />
      ))}
    </div>

    {hasMore && (
      <div class="mt-10 text-center">
        <p class="text-sm text-gray-500 mb-3">
          Showing top {VISIBLE_LIMIT} of {allInCategory.length} skills in {categoryName} by quality score.
        </p>
        <a
          href="/browse/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-700 text-gray-300 hover:border-atlas-400 hover:text-atlas-400 transition-colors text-sm"
        >
          Browse all {allInCategory.length} {categoryName} skills →
        </a>
      </div>
    )}
  </div>
</BaseLayout>

<script is:inline define:vars={{ categoryName, count }}>
  window.posthog?.capture('view_category', { category: categoryName, skill_count: count });
</script>
