---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillCard from '../components/SkillCard.astro';
import CategoryChip from '../components/CategoryChip.astro';
import { allSkills, getFeaturedSkills, getAllCategories, getStats, getPipelineStats } from '../lib/skills.js';
import { buildNewSkillsWeekChart, buildMaintenanceChart } from '../lib/charts.js';

const stats = getStats();
const pstats = getPipelineStats();
const featured = getFeaturedSkills(6);
const categories = getAllCategories();

// Phase 3.1.x: the homepage no longer renders the full catalog as hidden
// cards (that pattern produced a 74MB index.html at 35k records, blowing
// Cloudflare's 25MB per-asset cap). Top-60 is rendered statically; search
// is delegated to /api/v1/search (semantic, via Vectorize). Full catalog
// is browseable at /browse.
const HOMEPAGE_LIMIT = 60;
const allSorted = [...allSkills].sort((a, b) => b.quality_score - a.quality_score);
const topSkills = allSorted.slice(0, HOMEPAGE_LIMIT);

// Build-time SVG charts (pure, cached across builds, no client JS)
const newSkillsChartSvg = buildNewSkillsWeekChart(allSkills);
const maintenanceChartSvg = buildMaintenanceChart(allSkills);

// Human-readable "last updated" label for the hero. Prefers pipeline-stats
// timestamp (when the scraper last ran) and falls back to build time.
const updatedDate = pstats.updated_at ? new Date(pstats.updated_at) : new Date();
const updatedLabel = `Updated ${updatedDate.toISOString().slice(0, 10)}`;
---

<BaseLayout>
  <!-- Sticky Search Bar -->
  <div id="search-bar" class="sticky top-[57px] z-40 bg-gray-950/90 backdrop-blur border-b border-gray-800 px-4 py-3">
    <div class="max-w-3xl mx-auto relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        type="text"
        id="skill-search"
        placeholder={`Search ${pstats.total_indexed.toLocaleString()}+ Claude skills semantically...`}
        autocomplete="off"
        class="w-full pl-12 pr-12 py-3 bg-gray-900 border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-atlas-500 focus:border-transparent text-base"
      />
      <button
        id="search-clear"
        type="button"
        aria-label="Clear search"
        class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full text-gray-400 hover:text-white hover:bg-gray-800 flex items-center justify-center"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Hero -->
  <section class="py-16 sm:py-24 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 tracking-tight">
        Discover the best agent skills
      </h1>
      <p class="text-lg sm:text-xl text-gray-400 mb-2 max-w-2xl mx-auto">
        The curated index for production-quality Claude ecosystem skills.
      </p>
      <p class="text-sm text-gray-500 mb-8 font-mono">
        {pstats.total_discovered.toLocaleString()}+ analyzed &middot; {pstats.total_indexed.toLocaleString()} indexed &middot; {pstats.total_featured} Featured &middot; {updatedLabel}
      </p>

      <!-- Category chips -->
      <div class="flex flex-wrap justify-center gap-2 mb-4">
        {categories.map(cat => (
          <CategoryChip category={cat.name} count={cat.count} />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Skills -->
  {featured.length > 0 && (
    <section id="featured-section" class="px-4 pb-12">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Featured Skills
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {featured.map(skill => (
            <SkillCard skill={skill} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Ecosystem Pulse (charts) -->
  <section id="ecosystem-section" class="px-4 pb-12 relative">
    <!-- Shared hover tooltip for both Pulse charts. Positioned by JS below. -->
    <div id="chart-tooltip" class="pointer-events-none fixed hidden z-[60] rounded-lg bg-gray-950 border border-gray-700 shadow-xl px-3 py-2 text-xs font-mono text-gray-100 whitespace-nowrap"></div>
    <div class="max-w-3xl mx-auto">
      <h2 class="text-xl font-semibold text-white mb-6 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Ecosystem Pulse
      </h2>

      <!-- New skills per week -->
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-6">
        <div class="flex items-baseline justify-between mb-3">
          <h3 class="text-sm font-semibold text-gray-300 uppercase tracking-wide">New skills per week</h3>
          <span class="text-xs text-gray-500 font-mono">Last 52 weeks</span>
        </div>
        <div set:html={newSkillsChartSvg} />
        <p class="text-xs text-gray-500 mt-3">Based on the first commit that touched each skill file. Falls back to the repo's creation date where commit history is unavailable.</p>
      </div>

      <!-- Active maintenance -->
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <div class="flex items-baseline justify-between mb-3">
          <h3 class="text-sm font-semibold text-gray-300 uppercase tracking-wide">Active maintenance</h3>
          <span class="text-xs text-gray-500 font-mono">By last push</span>
        </div>
        <div set:html={maintenanceChartSvg} />
        <p class="text-xs text-gray-500 mt-3">How many indexed skill repos have been pushed to recently. "Stale" means no pushes in 6+ months — still indexed, but not currently maintained.</p>
      </div>
    </div>
  </section>

  <!-- Top Skills / Full Catalog -->
  <section class="px-4 pb-16">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-6">
        <h2 id="skills-heading" class="text-xl font-semibold text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-atlas-500"></span>
          <span id="skills-heading-text">Top Skills</span>
        </h2>
        <span id="skills-count" class="text-sm text-gray-500">Showing top {HOMEPAGE_LIMIT} of {pstats.total_indexed.toLocaleString()}</span>
      </div>

      <!-- Static top-60 grid (always present; hidden during active search) -->
      <div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {topSkills.map(skill => (
          <SkillCard skill={skill} />
        ))}
      </div>

      <!-- Search results grid (populated by JS during active search) -->
      <div id="search-results" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>

      <!-- Empty / error states -->
      <div id="search-loading" class="hidden text-center py-12 text-gray-500">
        <svg class="animate-spin w-6 h-6 mx-auto mb-3 text-atlas-400" fill="none" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle>
          <path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
        </svg>
        Searching…
      </div>
      <div id="no-results" class="hidden text-center py-12 text-gray-500">
        No skills match your search. Try different keywords or <a href="/category/ai-and-automation/" class="text-atlas-400 hover:underline">browse by category</a>.
      </div>
      <div id="search-error" class="hidden text-center py-12 text-gray-500">
        Search temporarily unavailable. <button id="search-retry" class="text-atlas-400 hover:underline">Try again</button> or <a href="/browse/" class="text-atlas-400 hover:underline">browse all skills</a>.
      </div>

      <!-- "See all" link to /browse -->
      <div id="see-all" class="text-center mt-10">
        <a href="/browse/" class="inline-flex items-center gap-2 text-sm text-atlas-400 hover:text-atlas-300 hover:underline">
          See all {pstats.total_indexed.toLocaleString()} skills
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>

      <div id="browse-more" class="text-center mt-10">
        <p class="text-gray-500 text-sm mb-4">Want to explore more?</p>
        <div class="flex flex-wrap justify-center gap-2">
          {categories.map(cat => (
            <CategoryChip category={cat.name} count={cat.count} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('skill-search') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  const featuredSection = document.getElementById('featured-section');
  const ecosystemSection = document.getElementById('ecosystem-section');
  const browseMore = document.getElementById('browse-more');
  const seeAll = document.getElementById('see-all');
  const skillsHeadingText = document.getElementById('skills-heading-text');
  const skillsCount = document.getElementById('skills-count');
  const skillsGrid = document.getElementById('skills-grid');
  const searchResults = document.getElementById('search-results');
  const searchLoading = document.getElementById('search-loading');
  const noResults = document.getElementById('no-results');
  const searchError = document.getElementById('search-error');
  const searchRetry = document.getElementById('search-retry');

  const initialCountText = skillsCount?.textContent || '';

  // --- Color helpers (mirror src/lib/skills.js tierColor + categoryColor) ---
  function tierLabel(tier: string): string {
    if (tier === 'featured') return 'Featured';
    if (tier === 'solid') return 'Solid';
    return 'Listed';
  }
  function tierClasses(tier: string): { bg: string; text: string; dot: string } {
    if (tier === 'featured') return { bg: 'bg-amber-100', text: 'text-amber-800', dot: 'bg-amber-500' };
    if (tier === 'solid')    return { bg: 'bg-emerald-100', text: 'text-emerald-800', dot: 'bg-emerald-500' };
    return { bg: 'bg-gray-100', text: 'text-gray-600', dot: 'bg-gray-400' };
  }
  function categoryClasses(category: string): string {
    const colors: Record<string, string> = {
      'Code & Development': 'bg-blue-100 text-blue-800',
      'Web & Frontend': 'bg-purple-100 text-purple-800',
      'Testing & QA': 'bg-green-100 text-green-800',
      'Data & Documents': 'bg-orange-100 text-orange-800',
      'DevOps & Infrastructure': 'bg-red-100 text-red-800',
      'API & Backend': 'bg-indigo-100 text-indigo-800',
      'AI & Automation': 'bg-pink-100 text-pink-800',
      'Productivity & Other': 'bg-gray-100 text-gray-700',
    };
    return colors[category] || 'bg-gray-100 text-gray-700';
  }

  function escapeHtml(s: string): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Render one search-result card. Matches SkillCard.astro visual structure.
  function renderResultCard(r: {
    slug: string;
    name: string;
    category?: string;
    quality_tier?: string;
    repo_stars?: number;
    repo_full_name?: string;
    description?: string;
    detail_url?: string;
  }): string {
    const tier = r.quality_tier || 'listed';
    const tc = tierClasses(tier);
    const cc = categoryClasses(r.category || '');
    const stars = (r.repo_stars || 0).toLocaleString();
    const owner = (r.repo_full_name || '').split('/')[0] || '';
    const href = r.detail_url || `/skills/${r.slug}/`;
    const desc = r.description || 'No description available.';
    const cat = r.category || 'Productivity & Other';

    return `
      <a href="${escapeHtml(href)}" class="group block bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-atlas-600 hover:bg-gray-900/80 transition-all duration-200">
        <div class="flex items-start justify-between gap-3 mb-3">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${cc}">
            ${escapeHtml(cat)}
          </span>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium ${tc.bg} ${tc.text}">
            <span class="w-1.5 h-1.5 rounded-full ${tc.dot}"></span>
            ${escapeHtml(tierLabel(tier))}
          </span>
        </div>
        <h3 class="text-white font-semibold text-lg mb-1 group-hover:text-atlas-400 transition-colors font-mono">
          ${escapeHtml(r.name || r.slug)}
        </h3>
        <p class="text-gray-400 text-sm mb-4 line-clamp-2 leading-relaxed">
          ${escapeHtml(desc)}
        </p>
        <div class="flex items-center justify-between text-xs text-gray-500">
          <div class="flex items-center gap-3">
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/></svg>
              ${escapeHtml(stars)}
            </span>
          </div>
          <span class="text-gray-600 font-mono text-[11px]">
            ${escapeHtml(owner)}
          </span>
        </div>
      </a>
    `;
  }

  // --- View state helpers ---
  function showEmptyState() {
    if (searchClear) searchClear.classList.add('hidden');
    if (featuredSection) (featuredSection as HTMLElement).style.display = '';
    if (ecosystemSection) (ecosystemSection as HTMLElement).style.display = '';
    if (browseMore) (browseMore as HTMLElement).style.display = '';
    if (seeAll) (seeAll as HTMLElement).style.display = '';
    if (skillsHeadingText) skillsHeadingText.textContent = 'Top Skills';
    if (skillsCount) skillsCount.textContent = initialCountText;

    if (skillsGrid) skillsGrid.classList.remove('hidden');
    if (searchResults) {
      searchResults.classList.add('hidden');
      searchResults.innerHTML = '';
    }
    if (searchLoading) searchLoading.classList.add('hidden');
    if (noResults) noResults.classList.add('hidden');
    if (searchError) searchError.classList.add('hidden');
  }

  function showSearchingState() {
    if (searchClear) searchClear.classList.remove('hidden');
    if (featuredSection) (featuredSection as HTMLElement).style.display = 'none';
    if (ecosystemSection) (ecosystemSection as HTMLElement).style.display = 'none';
    if (browseMore) (browseMore as HTMLElement).style.display = 'none';
    if (seeAll) (seeAll as HTMLElement).style.display = 'none';
    if (skillsHeadingText) skillsHeadingText.textContent = 'Search Results';

    if (skillsGrid) skillsGrid.classList.add('hidden');
    if (searchResults) searchResults.classList.add('hidden');
    if (noResults) noResults.classList.add('hidden');
    if (searchError) searchError.classList.add('hidden');
    if (searchLoading) searchLoading.classList.remove('hidden');
    if (skillsCount) skillsCount.textContent = 'Searching…';
  }

  // --- Semantic search via /api/v1/search ---
  let searchToken = 0;
  let lastQuery = '';

  async function runSemanticSearch(query: string) {
    const thisToken = ++searchToken;
    lastQuery = query;
    showSearchingState();

    let payload: { results: Array<Record<string, any>> } | null = null;
    try {
      const url = `/api/v1/search?q=${encodeURIComponent(query)}&k=30`;
      const res = await fetch(url, { headers: { accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      payload = await res.json();
      if (!payload || !Array.isArray(payload.results)) throw new Error('malformed response');
    } catch (err) {
      console.error('Semantic search failed:', err);
      if (thisToken !== searchToken) return;
      if (searchLoading) searchLoading.classList.add('hidden');
      if (searchError) searchError.classList.remove('hidden');
      if (skillsCount) skillsCount.textContent = '';
      return;
    }

    // Dropped if a newer query came in mid-flight.
    if (thisToken !== searchToken) return;

    const results = payload.results;
    if (searchLoading) searchLoading.classList.add('hidden');

    if (results.length === 0) {
      if (searchResults) {
        searchResults.classList.add('hidden');
        searchResults.innerHTML = '';
      }
      if (noResults) noResults.classList.remove('hidden');
      if (skillsCount) skillsCount.textContent = 'No semantic matches';
      return;
    }

    if (searchResults) {
      searchResults.innerHTML = results.map(renderResultCard).join('');
      searchResults.classList.remove('hidden');
    }
    if (skillsCount) {
      skillsCount.textContent = `${results.length} relevant result${results.length === 1 ? '' : 's'} · semantic match`;
    }
  }

  // --- Debounced input handler (250ms) ---
  let debounceTimer: number | null = null;
  searchInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    if (debounceTimer) window.clearTimeout(debounceTimer);

    if (val.length === 0) {
      searchToken++; // cancel any in-flight search
      showEmptyState();
      return;
    }

    if (searchClear) searchClear.classList.remove('hidden');
    debounceTimer = window.setTimeout(() => {
      runSemanticSearch(val);
    }, 250);
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchToken++;
      showEmptyState();
      searchInput.focus();
    }
  });

  searchRetry?.addEventListener('click', () => {
    if (lastQuery) runSemanticSearch(lastQuery);
  });

  // Initialize state on page load
  showEmptyState();

  // --- Ecosystem Pulse chart tooltips ---
  const tooltipEl = document.getElementById('chart-tooltip');
  if (tooltipEl) {
    const ecosystemSectionEl = document.getElementById('ecosystem-section');
    if (ecosystemSectionEl) {
      ecosystemSectionEl.addEventListener('mousemove', (e) => {
        const target = (e.target as Element).closest('.chart-bar') as SVGElement | null;
        if (!target) {
          tooltipEl.classList.add('hidden');
          return;
        }
        const text = target.getAttribute('data-tooltip');
        if (!text) {
          tooltipEl.classList.add('hidden');
          return;
        }
        tooltipEl.textContent = text;
        tooltipEl.classList.remove('hidden');
        // Position relative to the viewport, offset from cursor
        const pad = 14;
        const ttW = tooltipEl.offsetWidth;
        const ttH = tooltipEl.offsetHeight;
        const me = e as MouseEvent;
        let left = me.clientX + pad;
        let top = me.clientY + pad;
        if (left + ttW + pad > window.innerWidth) left = me.clientX - ttW - pad;
        if (top + ttH + pad > window.innerHeight) top = me.clientY - ttH - pad;
        tooltipEl.style.left = `${left}px`;
        tooltipEl.style.top = `${top}px`;
      });

      ecosystemSectionEl.addEventListener('mouseleave', () => {
        tooltipEl.classList.add('hidden');
      });
    }
  }
</script>
