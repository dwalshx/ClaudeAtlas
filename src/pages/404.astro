---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found" description="The page you're looking for doesn't exist.">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-white mb-4 font-mono">404</h1>
    <p class="text-xl text-gray-400 mb-8">This skill wandered off the map.</p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-atlas-600 hover:bg-atlas-500 rounded-lg text-white font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to ClaudeAtlas
    </a>
  </div>
</BaseLayout>
