---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCreators, getCreatorLeaderboards } from '../../lib/skills.js';

const creators = getCreators();
const leaderboards = getCreatorLeaderboards(10);
const totalCreators = creators.size;

function formatQualityMetric(c: any) {
  // Show one decimal when the precise and rounded differ enough to matter
  const precise = c.avg_quality_score_precise ?? c.avg_quality_score;
  const display = Number.isInteger(precise) ? `${precise}` : precise.toFixed(1);
  return `${display} · ${c.total_skills} skills`;
}

const boards = [
  { key: 'byFeatured', title: 'Most Featured', desc: 'Creators with the most Featured-tier skills', data: leaderboards.byFeatured, metric: (c: any) => `${c.tier_counts.featured} Featured` },
  { key: 'prolific', title: 'Prolific', desc: 'Creators with the most indexed skills', data: leaderboards.prolific, metric: (c: any) => `${c.total_skills} skills` },
  { key: 'quality', title: 'Quality', desc: 'Highest average quality score (2+ skills)', data: leaderboards.quality, metric: formatQualityMetric },
  { key: 'rising', title: 'Rising', desc: 'Newest Featured skills first', data: leaderboards.rising, metric: (c: any) => c.rising_since ? new Date(c.rising_since).toISOString().slice(0, 10) : '—' },
];
---

<BaseLayout title="Creators" description="Browse Claude skill creators — leaderboards by Featured count, prolific output, quality score, and rising momentum.">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-white mb-3">Creators</h1>
      <p class="text-gray-400 max-w-2xl">
        {totalCreators.toLocaleString()} creators have at least one indexed skill on ClaudeAtlas. Four leaderboards highlight different strengths — featured count, prolific output, average quality, and rising momentum.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {boards.map(board => (
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <div class="flex items-baseline justify-between mb-1">
            <h2 class="text-lg font-semibold text-white">{board.title}</h2>
            <span class="text-xs text-gray-500 uppercase tracking-wide">Top 10</span>
          </div>
          <p class="text-xs text-gray-500 mb-4">{board.desc}</p>
          <ol class="space-y-2">
            {board.data.map((c: any, i: number) => (
              <li class="flex items-center gap-3">
                <span class="text-xs text-gray-600 font-mono w-5 text-right">{i + 1}</span>
                {c.avatar_url && (
                  <img src={c.avatar_url} alt="" loading="lazy" class="w-7 h-7 rounded-full bg-gray-800" />
                )}
                <a href={`/creators/${c.username}/`} class="flex-1 min-w-0 truncate text-sm text-gray-200 hover:text-atlas-400 transition-colors">
                  {c.username}
                </a>
                <span class="text-xs text-gray-500 font-mono">{board.metric(c)}</span>
              </li>
            ))}
            {board.data.length === 0 && (
              <li class="text-xs text-gray-600 italic">No creators yet</li>
            )}
          </ol>
        </div>
      ))}
    </div>

    <p class="text-xs text-gray-600 mt-10 text-center">
      Bios and custom profile info are coming in a future update. For now, every creator page is built from the skills we've indexed.
    </p>
  </section>
</BaseLayout>
