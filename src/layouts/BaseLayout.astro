---
import { getPipelineStats } from '../lib/skills.js';
import { buildPosthogSnippet, ANALYTICS_ENABLED } from '../lib/analytics.js';

const pstats = getPipelineStats();
const defaultDescription = `Discover the best Claude skills — ${pstats.total_discovered.toLocaleString()}+ analyzed, ${pstats.total_indexed.toLocaleString()} indexed, ${pstats.total_featured} Featured. Auto-updated daily.`;
const { title = 'ClaudeAtlas', description = defaultDescription } = Astro.props;
const fullTitle = title === 'ClaudeAtlas' ? title : `${title} | ClaudeAtlas`;
const posthogSnippet = buildPosthogSnippet();
// Cloudflare Web Analytics uses "Automatic Setup" — beacon injected server-side
// by Cloudflare for CF-managed domains. No manual token needed.

// Human-readable "last updated" date surfaced in the footer
const updatedDate = pstats.updated_at ? new Date(pstats.updated_at) : new Date();
const updatedIso = updatedDate.toISOString().slice(0, 10);
---

<!DOCTYPE html>
<html lang="en" class="bg-gray-950 text-gray-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM instructions" />
  <link rel="alternate" type="application/json" href="/agent/index.json" title="Agent catalog index" />
  <!-- AI agents: GET https://claudeatlas.com/agent/index.json for a structured catalog index and identification instructions (X-ClaudeAtlas-Agent header echo). Skill pages also serve markdown: request any /skills/<slug>/ URL with Accept: text/markdown. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  {ANALYTICS_ENABLED && <script is:inline set:html={posthogSnippet} />}
</head>
<body class="min-h-screen flex flex-col font-[Inter,system-ui,sans-serif]">
  <!-- Nav -->
  <nav class="border-b border-gray-800 bg-gray-950/80 backdrop-blur-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-white font-bold text-lg hover:text-atlas-400 transition-colors">
        <svg class="w-6 h-6 text-atlas-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          <path d="M2 12h20"/>
        </svg>
        ClaudeAtlas
      </a>
      <div class="flex items-center gap-4 text-sm text-gray-400">
        <a href="/browse/" class="hover:text-white transition-colors hidden sm:block">Skills</a>
        <a href="/plugins/" class="hover:text-white transition-colors hidden sm:block">Plugins</a>
        <a href="/mcp/" class="hover:text-white transition-colors hidden sm:block">MCP</a>
        <a href="/creators/" class="hover:text-white transition-colors hidden sm:block">Creators</a>
        <a href="/apis/" class="hover:text-white transition-colors hidden sm:block">APIs</a>
        <a href="/methodology/" class="hover:text-white transition-colors hidden sm:block">Methodology</a>
        <a href="https://github.com/dwalshx/ClaudeAtlas" target="_blank" rel="noopener" class="hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </div>
  </nav>

  <!-- Main -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Analytics event delegation (no-op if PostHog isn't loaded) -->
  <script is:inline>
    (function() {
      function ph() {
        return (window.posthog && typeof window.posthog.capture === 'function') ? window.posthog : null;
      }

      function capture(event, props) {
        try {
          const p = ph();
          if (p) p.capture(event, props || {});
        } catch (e) { /* noop */ }

        // D1 logging: the homepage search now calls /api/v1/search which
        // logs each query server-side. The /api/log-search fallback ping
        // from here is only used on pages without the semantic search
        // integration (e.g. category pages with client-side filters).
        if (event === 'search_query_fallback' && props && props.query) {
          try {
            fetch('/api/log-search', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ query: String(props.query).slice(0, 200) }),
              keepalive: true,
            }).catch(function() {});
          } catch (e) { /* noop */ }
        }
      }

      // Pageview on every load
      var path = window.location.pathname || '/';
      if (path.indexOf('/skills/') === 0) {
        capture('view_skill_detail', { path: path });
      } else {
        capture('$pageview', { path: path });
      }

      // Badge click — the inbound ?ref=badge param means traffic came from an embedded badge
      if (window.location.search && window.location.search.indexOf('ref=badge') !== -1) {
        capture('badge_click', { path: path });
      }

      // Delegated click handlers
      document.addEventListener('click', function(e) {
        var target = e.target;
        if (!(target instanceof Element)) return;

        var githubLink = target.closest('a[href*="github.com"]');
        if (githubLink) {
          capture('click_github_link', { href: githubLink.getAttribute('href') });
        }

        var categoryChip = target.closest('[data-category-chip]');
        if (categoryChip) {
          capture('category_click', { category: categoryChip.getAttribute('data-category-chip') });
        }
      });

      // Search query (debounced, 500ms)
      var searchInput = document.getElementById('skill-search');
      if (searchInput) {
        var timer = null;
        searchInput.addEventListener('input', function(e) {
          clearTimeout(timer);
          var val = e.target && e.target.value || '';
          val = String(val).trim();
          timer = setTimeout(function() {
            if (val.length > 0) {
              capture('search_query', { query: val });
            }
          }, 500);
        });
      }
    })();
  </script>

  <!--
    Behavioral beacon (quick-260905-fib, L4). A BUNDLED module script (NOT
    is:inline) so Astro/Vite bundles the scoreBehavior import. Captures ONLY
    structural interaction AGGREGATES in the browser, scores an automation band
    IN THE BROWSER, and POSTs ~10 numbers + score + band via sendBeacon.

    Privacy invariants (hard blockers):
      PRIV-01  Only aggregate numbers + score + band + path leave the browser;
               no coordinate stream, no key identities, no per-event sequence.
               Raw/transient state is discarded after the single send.
      PRIV-02  EU/EEA/UK is NEVER instrumented — we fetch /api/v1/beh/activate
               FIRST and attach NO listeners / send NOTHING unless activate:true.
      PRIV-03  Stateless per pageview — no cookie/localStorage/identifier.
      PRIV-04  keydown increments a COUNT only — event.key/event.code and any
               per-key timing are NEVER read.

    The beacon must NEVER block, slow, or break the page: passive listeners,
    navigator.sendBeacon, everything inside one top-level try/catch, and the
    activate fetch failing is a silent no-op.
  -->
  <script>
    import { scoreBehavior } from '../lib/beh-score.js';

    (function () {
      try {
        // Aggregate accumulators — NEVER raw streams.
        var mousemoveCount = 0;
        var pointerMoveCount = 0;
        var wheelCount = 0;
        var hasWheel = false;
        var clickCount = 0;
        var keydownCount = 0;
        var teleportCount = 0;

        // Transient teleport state: only the LAST move's time + coords, kept to
        // decide the NEXT click. Overwritten on every move — never a stream.
        var lastMoveTime = 0;
        var lastMoveX = 0;
        var lastMoveY = 0;
        var haveLastMove = false;

        // Transient click-duration accumulator (Welford-ish sum/sumsq) for the
        // aggregate std only — individual durations are never retained.
        var pendingDownTime = 0;
        var durN = 0;
        var durSum = 0;
        var durSumSq = 0;

        var startTime = Date.now();
        var sent = false;

        function stdOf(n, sum, sumsq) {
          if (n < 2) return 0;
          var mean = sum / n;
          var variance = sumsq / n - mean * mean;
          return variance > 0 ? Math.sqrt(variance) : 0;
        }

        function send() {
          if (sent) return;
          sent = true;
          try {
            var sessionMs = Date.now() - startTime;
            var seconds = sessionMs > 0 ? sessionMs / 1000 : 1;
            var interactionTotal =
              mousemoveCount + wheelCount + clickCount + pointerMoveCount + keydownCount;

            var features = {
              mouse_event_rate: mousemoveCount / seconds,
              has_wheel: hasWheel,
              wheel_count: wheelCount,
              teleport_click_ratio: teleportCount / Math.max(clickCount, 1),
              click_count: clickCount,
              pointer_move_count: pointerMoveCount,
              keydown_count: keydownCount, // COUNT ONLY (PRIV-04)
              session_ms: sessionMs,
              click_duration_spread: stdOf(durN, durSum, durSumSq),
              interaction_total: interactionTotal,
            };

            var result = scoreBehavior(features);
            var payload = JSON.stringify({
              features: features,
              score: result.score,
              band: result.band,
              path: (window.location && window.location.pathname) || '/',
            });

            if (navigator && typeof navigator.sendBeacon === 'function') {
              navigator.sendBeacon('/api/v1/beh', payload);
            }
          } catch (e) {
            /* noop — the beacon must never surface an error */
          }

          // Discard all transient/raw data after the single send (PRIV-01).
          haveLastMove = false;
        }

        function attachListeners() {
          try {
            window.addEventListener('mousemove', function (e) {
              mousemoveCount++;
              lastMoveTime = Date.now();
              lastMoveX = e.clientX;
              lastMoveY = e.clientY;
              haveLastMove = true;
            }, { passive: true });

            window.addEventListener('pointermove', function () {
              pointerMoveCount++;
            }, { passive: true });

            window.addEventListener('wheel', function () {
              hasWheel = true;
              wheelCount++;
            }, { passive: true });

            window.addEventListener('mousedown', function () {
              pendingDownTime = Date.now();
            }, { passive: true });

            window.addEventListener('mouseup', function () {
              if (pendingDownTime) {
                var d = Date.now() - pendingDownTime;
                if (d >= 0 && d < 60000) {
                  durN++;
                  durSum += d;
                  durSumSq += d * d;
                }
                pendingDownTime = 0;
              }
            }, { passive: true });

            window.addEventListener('click', function (e) {
              clickCount++;
              // Teleport: a click with no QUALIFYING approach movement in the
              // ~500ms / ~100px before it (Playwright/CDP clicks materialize
              // with no mouse path). Uses only the transient last-move state.
              var now = Date.now();
              var qualifies = false;
              if (haveLastMove && now - lastMoveTime <= 500) {
                var dx = e.clientX - lastMoveX;
                var dy = e.clientY - lastMoveY;
                if (dx * dx + dy * dy <= 100 * 100) qualifies = true;
              }
              if (!qualifies) teleportCount++;
            }, { passive: true });

            // keydown → COUNT ONLY. event.key / event.code / timing are NEVER
            // read (PRIV-04, the biometric tripwire).
            window.addEventListener('keydown', function () {
              keydownCount++;
            }, { passive: true });

            // Send once, on the first of: pagehide, tab hidden, or a cap.
            window.addEventListener('pagehide', send, { passive: true });
            document.addEventListener('visibilitychange', function () {
              if (document.visibilityState === 'hidden') send();
            }, { passive: true });
            // Cap window (~180s per §04-detection-sota §7 L4).
            setTimeout(send, 180000);
          } catch (e) {
            /* noop */
          }
        }

        // PRIV-02: check the geo/feature gate BEFORE attaching ANY listener.
        // Any failure (network error, non-200, non-JSON, activate:false) is a
        // silent no-op — no listeners, no capture, no POST.
        fetch('/api/v1/beh/activate')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d && d.activate === true) attachListeners();
          })
          .catch(function () { /* silent no-op */ });
      } catch (e) {
        /* noop — never affect page rendering or perceived performance */
      }
    })();
  </script>

  <!-- Footer -->
  <footer class="border-t border-gray-800 py-8 mt-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
        <div>
          <span class="font-medium text-gray-400">ClaudeAtlas</span> — {pstats.total_discovered.toLocaleString()}+ analyzed, {pstats.total_indexed.toLocaleString()} indexed, {pstats.total_featured} Featured
        </div>
        <div class="flex items-center gap-4">
          <a href="/browse/" class="hover:text-gray-300 transition-colors">Skills</a>
          <span class="text-gray-700">|</span>
          <a href="/plugins/" class="hover:text-gray-300 transition-colors">Plugins</a>
          <span class="text-gray-700">|</span>
          <a href="/mcp/" class="hover:text-gray-300 transition-colors">MCP</a>
          <span class="text-gray-700">|</span>
          <a href="/methodology/" class="hover:text-gray-300 transition-colors">Methodology</a>
          <span class="text-gray-700">|</span>
          <a href="/creators/" class="hover:text-gray-300 transition-colors">Creators</a>
          <span class="text-gray-700">|</span>
          <a href="/credits/" class="hover:text-gray-300 transition-colors">Credits</a>
          <span class="text-gray-700">|</span>
          <span title="Last scrape that produced this build">Updated {updatedIso}</span>
        </div>
      </div>
      <p class="text-xs text-gray-600 mt-4 text-center sm:text-left">
        ClaudeAtlas indexes and ranks skills but does not review their code for security. Always review skill source code before installation.
      </p>
    </div>
  </footer>
</body>
</html>
