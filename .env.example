# ClaudeAtlas — local environment template
#
# Copy this file to `.env` (gitignored) and fill in the values you need
# for your local environment. Only variables you actually use need to be
# set — every script has a clear error if a required var is missing.
#
# See docs/SECRETS.md for the full "what goes where" reference, including
# which vars also need to be set as GitHub Actions secrets and Cloudflare
# Worker secrets.

# ---------------------------------------------------------------------------
# LOCAL DEV ONLY — used by scripts/ when run from your machine
# ---------------------------------------------------------------------------

# GitHub personal access token (fine-grained PAT with "Public Repositories
# read-only" scope). Used by:
#   - scripts/scrape.js
#   - scripts/backfill-star-history.js
#   - scripts/backfill-skill-birth-dates.js
#
# Get one at: https://github.com/settings/tokens?type=beta
# Note: this is DIFFERENT from the SCRAPE_PAT used by the daily cron.
# Keep them separate so you can rotate this one without breaking CI.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# BUILD-TIME — baked into the client bundle at `npm run build`
# These must ALSO be set as GitHub Actions secrets for CI builds (see
# docs/SECRETS.md for the list of repo secrets to configure).
# ---------------------------------------------------------------------------

# PostHog project API key (starts with `phc_...`). From the EU PostHog
# cloud: https://eu.posthog.com → Project Settings → Project API Key.
# If unset, the PostHog loader is a no-op and no events fire.
PUBLIC_POSTHOG_KEY=

# Cloudflare Web Analytics:
# Enabled via "Automatic Setup" in the Cloudflare dashboard. The beacon
# is injected server-side by Cloudflare for CF-managed domains — no env
# var or client-side snippet needed.
